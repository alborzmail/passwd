[Unit]
Description=alborz password changes (poppassd)
Requires=alborz-passwd.socket

[Service]
ExecStart=/usr/local/sbin/alborz-passwd -passwd-file /etc/dovecot/passwd.d/users
User=alborz-passwd
Group=dovecot
# Writes a new file beside the old one and renames it; keeping the file's owner takes CAP_CHOWN.
ReadWritePaths=/etc/dovecot/passwd.d
AmbientCapabilities=CAP_CHOWN
CapabilityBoundingSet=CAP_CHOWN
NoNewPrivileges=yes
# doveadm pw -t takes the old hash as an argument; other users must not see the process.
ProtectProc=invisible
ProcSubset=pid
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
